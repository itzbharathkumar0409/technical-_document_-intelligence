# Backend
DATABASE_URL=postgresql+asyncpg://dociq:dociq_secret@localhost:5432/dociq
DATABASE_URL_SYNC=postgresql://dociq:dociq_secret@localhost:5432/dociq

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:3000

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/uploads

# LLM Provider: "ollama" or "openai"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# OpenAI-compatible (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BASE_URL=

# Reranker
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_FINAL_TOP_K=8
RELEVANCE_THRESHOLD=0.3

# Chunking
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# Rate Limiting
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_QA=20/minute

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL (for docker-compose)
POSTGRES_USER=dociq
POSTGRES_PASSWORD=dociq_secret
POSTGRES_DB=dociq
